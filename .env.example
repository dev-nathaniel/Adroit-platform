# ==============================================================================
# Adroit Platform - Global Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ADROIT_ENV=development
ADROIT_LOG_LEVEL=debug
ADROIT_LOG_FORMAT=json

# ==============================================================================
# Service Ports (Local Development Mapping)
# ==============================================================================
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
PROJECT_SERVICE_PORT=8083
BUILD_SERVICE_PORT=8084
RUNTIME_SERVICE_PORT=8085
ORCHESTRATION_SERVICE_PORT=8086
MANAGED_DB_SERVICE_PORT=8087
DNS_SERVICE_PORT=8088
BILLING_SERVICE_PORT=8089
LOG_SERVICE_PORT=8090
NOTIFICATION_SERVICE_PORT=8091
GIT_INTEGRATION_SERVICE_PORT=8092
DOCKER_REGISTRY_SERVICE_PORT=8093

# ==============================================================================
# Backing Infrastructure
# ==============================================================================

# PostgreSQL (Platform State)
DB_HOST=localhost
DB_PORT=5432
DB_USER=adroit
DB_PASSWORD=adroit_secret
DB_NAME=adroit_platform
DB_SSLMODE=disable

# Redis (Caching & Rate Limiting)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# NATS JetStream (Async Event Mesh)
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=adroit-cluster

# HashiCorp Control Plane
NOMAD_ADDR=http://localhost:4646
NOMAD_TOKEN=
BUILD_RUNNER_TYPE=nomad
ORCHESTRATOR_DRIVER_TYPE=nomad
CONSUL_ADDR=http://localhost:8500
CONSUL_TOKEN=
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=

# JWT Secrets
JWT_SECRET=super-secret-development-jwt-signing-key-change-in-production
JWT_EXPIRATION_HOURS=24

# ==============================================================================
# GitHub OAuth Configuration
# ==============================================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback
GITHUB_FRONTEND_URL=http://localhost:3000/auth/callback

