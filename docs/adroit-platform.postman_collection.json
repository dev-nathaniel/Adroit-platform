				{
					"name": "Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var res = pm.response.json();",
									"    if (res.data && res.data.token) {",
									"        pm.collectionVariables.set('token', res.data.token);",
									"        console.log('Saved token to collection variable: token');",
									"    }",
									"    if (res.data && res.data.organization && res.data.organization.id) {",
									"        pm.collectionVariables.set('orgId', res.data.organization.id);",
									"        console.log('Saved default workspace id to collection variable: orgId');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
