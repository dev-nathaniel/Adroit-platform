									"    var res = pm.response.json();",
									"    if (res.data) {",
									"        if (res.data.token) {",
									"            pm.collectionVariables.set('inviteToken', res.data.token);",
									"            console.log('Saved invitation token to inviteToken');",
									"        }",
									"        if (res.data.id) {",
									"            pm.collectionVariables.set('inviteId', res.data.id);",
									"            console.log('Saved invitation ID to inviteId: ' + res.data.id);",
									"        }",
